# Production Environment Configuration
NODE_ENV=production
PORT=5000

# Database - REPLACE WITH YOUR PRODUCTION MONGODB URI
MONGODB_URI=your-production-mongodb-uri-here

# JWT Configuration - GENERATE NEW SECRET FOR PRODUCTION
JWT_SECRET=your-production-jwt-secret-minimum-32-characters-long
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Setup Secret for Initial Admin Creation (Change this!)
SETUP_SECRET=your-super-secret-setup-key-change-this

# CORS - Your deployed frontend URL
FRONTEND_URL=https://studyio.in

# Judge0 API (Optional)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-judge0-api-key

# Cloudinary (Optional)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
